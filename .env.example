# Values below are the canonical Linux-server defaults; override them locally.

# QUICKDDEVPREVIEWS_BASE_DOMAIN: the dashboard hostname. In production the
# installer auto-derives it from the server IP via sslip.io
# (e.g. 1-2-3-4.sslip.io). Override with QDP_DOMAIN passed to the installer
# if you have a real domain. Leave UNSET for local dev: the session cookie
# becomes host-only and http://localhost:3000 works with no DNS setup.
# (Phase 2 previews will need a shared domain like lvh.me; Phase 1 does not.)
#QUICKDDEVPREVIEWS_BASE_DOMAIN=lvh.me

# QUICKDDEVPREVIEWS_BASE_URL: the dashboard's FULL public origin, used for
# URLs built server-side. Only needed where scheme or port differ from
# https://<QUICKDDEVPREVIEWS_BASE_DOMAIN>, i.e. in dev with a real domain.
#QUICKDDEVPREVIEWS_BASE_URL=http://lvh.me:3000

# ─── Production deployment (written by scripts/install.sh) ───────────────────
# All of these stay unset in dev. On a server the installer fills them in.
#
# QUICKDDEVPREVIEWS_DATA_DIR / QUICKDDEVPREVIEWS_DB_PATH: the app's own state
# (SQLite DB). Must point into the volume mounted in docker-compose.yml, or the
# DB dies with the container.
#QUICKDDEVPREVIEWS_DATA_DIR=/data/quickddevpreviews/data
#QUICKDDEVPREVIEWS_DB_PATH=/data/quickddevpreviews/data/quickddevpreviews.db
#
# QUICKDDEVPREVIEWS_VERSION: the release tag the instance runs (pins the
# ghcr.io image in docker-compose.yml).
#QUICKDDEVPREVIEWS_VERSION=v0.1.0
#
# QUICKDDEVPREVIEWS_INSTALL_DIR: where the repo checkout lives on the server.
#QUICKDDEVPREVIEWS_INSTALL_DIR=/opt/quickddevpreviews
#
# COMPOSE_PROFILES: `prod` also starts the caddy TLS entry point. Unset in dev
# (no caddy, plain http).
#COMPOSE_PROFILES=prod

# ─── Auth (nuxt-auth-utils) ───────────────────────────────────────────────────
# NUXT_SESSION_PASSWORD: seals the session cookie AND derives the AES key that
# encrypts any stored secrets. Any random string >= 32 chars.
#   Generate:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-at-least-32-chars