# quickddevpreviews TLS entry point for LOCAL use (lvh.me, or any domain that
# resolves to 127.0.0.1), installed via scripts/install.sh mode 3. Same two
# jobs as the stock Caddyfile (dashboard + per-run preview hosts), but the
# certificates come from Caddy's internal CA instead of Let's Encrypt, which
# cannot issue for a local domain. The browser shows a certificate warning;
# accept it once.
#
# This file replaces ./Caddyfile when the installer picks local mode. The
# stock Caddyfile (Let's Encrypt) is restored by a fresh install in a
# non-local mode.

{
	on_demand_tls {
		ask http://quickddevpreviews:3000/tls-ask
	}
}

{$QUICKDDEVPREVIEWS_BASE_DOMAIN} {
	tls internal
	reverse_proxy quickddevpreviews:3000
}

https:// {
	tls internal {
		on_demand
	}
	reverse_proxy quickddevpreviews:3000
}
